{
  "name": "labflow",
  "version": "1.3.0",
  "type": "module",
  "private": true,
  "main": "src/main/main.cjs",
  "scripts": {
    "start": "node scripts/start.js",
    "serve": "node scripts/serve-web.js",
    "create-user": "node scripts/create-user.js",
    "test": "node --test --test-force-exit test/*.test.mjs",
    "smoke-test": "node scripts/smoke-test.mjs",
    "build": "echo Web build ready",
    "build:electron": "electron-builder --win nsis",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "in.anandlab.labflow",
    "productName": "Labflow Diagnostics",
    "directories": {
      "output": "build-out"
    },
    "files": [
      "src/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Labflow Diagnostics"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "jsdom": "31.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  }
}
